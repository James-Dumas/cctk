GUI = {
    render = {
        buf_back = {},
        buf_front = {},
    },
    resize = true,
    redraw = true,
    exit = false,
}

function GUI:init(widget)
    -- initialize GUI with given widget as root
    widget.fill_mode = "full"
    widget.visible = true
    if widget.bg_color == nil then
        widget.bg_color = colors.black
    end
    self.root = widget
    term.setCursorBlink(false)
    term.clear()
end

function GUI:main()
    -- GUI main loop

    if not self.root then
        return
    end

    -- define function for handling os events
    local function main1()
        while not self.exit do
            local event_data = {os.pullEventRaw()}
            if event_data[1] == "mouse_click" then
                local clicked_widget = self.root:get_widget_by_pos(event_data[3], event_data[4])
                if clicked_widget then
                    clicked_widget:handle_click(unpack(event_data, 2, 4))
                end
            elseif event_data[1] == "term_resize" then
                self.root:resize()
                self.redraw = true
            elseif event_data[1] == "terminate" then
                self.exit = true
            end

            self.root:handle_event(unpack(event_data))
        end
    end

    -- define function for processing widget updates
    local function main2()
        while not self.exit do
            self.root:handle_tick()

            if self.resize then
                self.resize = false
                self.redraw = true
                self.root:update_size_want()
                local term_w, term_h = term.getSize()
                local screen_rect = {
                    x = 1,
                    y = 1,
                    w = term_w,
                    h = term_h,
                }
                self.root:update_rect(screen_rect)
            end

            if self.redraw then
                self.redraw = false
                self.root:draw(self.render.buf_back)
                self.render:draw()
            end

            os.sleep(0.05)
        end
    end

    -- Enter main loop
    parallel.waitForAll(main1, main2)
    term.clear()
    term.setCursorPos(1, 1)
end

function GUI.render:draw()
    -- copy back buffer to front buffer and draw changed chars
    local cursor_blink = term.getCursorBlink()
    local cursor_x, cursor_y = term.getCursorPos()
    term.setCursorBlink(false)
    self:blit_buf(self.buf_back, self.buf_front)
    term.setCursorBlink(cursor_blink)
    term.setCursorPos(cursor_x, cursor_y)
end

function GUI.render:blit_buf(buf_src, buf_dst, min_x, min_y, max_x, max_y)
    -- copy buf_src to buf_dst within the given rect
    -- if buf_dst is the render object's front buffer, then blit to term
    min_x = min_x or 1
    min_y = min_y or 1
    local width, height = term.getSize()
    max_x = max_x or width
    max_y = max_y or height
    for x = min_x, max_x do
        for y = min_y, max_y do
            local key = x .. "." .. y
            local src_char = buf_src[key]
            local dst_char = buf_dst[key]
            if src_char and (not dst_char or src_char.char ~= dst_char.char or src_char.fg ~= dst_char.fg or src_char.bg ~= dst_char.bg) then
                if buf_dst == self.buf_front then
                    term.setCursorPos(x, y)
                    term.blit(src_char.char, src_char.fg, src_char.bg)
                end

                buf_dst[key] = src_char
            end
        end
    end
end

function GUI.render:blit_char(char, x, y, fg, bg, buf)
    -- draw a single char to the render buffer
    local key = x .. "." .. y
    buf[key] = {
        char = char,
        fg = fg or colors.white,
        bg = bg or colors.black,
    }
end

function GUI.render:blit_text(text, x, y, fg, bg, buf)
    -- draw some text to the render buffer
    local h = 0
    local k = 0
    for i = 1, #text do
        local char = text:sub(i, i)
        if char == "\n" then
            k = k + 1
            h = 0
        else
            self:blit_char(char, x + h, y + k, fg, bg, buf)
            h = h + 1
        end
    end
end

function GUI.render:blit_rect(x, y, w, h, bg, buf)
    -- draw a rectangle to the render buffer
    for i = x, x + w - 1 do
        for j = y, y + h - 1 do
            self:blit_char(" ", i, j, bg, bg, buf)
        end
    end
end

function GUI.render:get_char(x, y)
    -- get the char at the given position
    local key = x .. "." .. y
    return self.buf_front[key]
end

function GUI.render:clear()
    -- clear the render buffer and screen
    self.buf_back = {}
    self.buf_front = {}
    term.clear()
end

-- Base Widget class
Widget = {
    visible = true,
    fill_mode = "none",
    h_align = "top",
    v_align = "left",
    fg_color = colors.white,
    bg_color = nil, -- inherit from parent
    event_handlers = {},
}
Widget.__index = Widget

function Widget:new()
    local o = {}
    setmetatable(o, self)
    o.rect = {
        x = 0,
        y = 0,
        w = 0,
        h = 0
    }
    o.size_want = {
        w = 0,
        h = 0,
    }
    o.padding = {
        left = 0,
        right = 0,
        top = 0,
        bottom = 0
    }

    return o
end

function Widget:update_size_want()
    -- recalculate wanted size for the widget
    self.size_want = {
        w = 0,
        h = 0,
    }
end

function Widget:update_rect(available_rect)
    -- update widget rect based on available space and fill mode

    -- use all available width
    if self.fill_mode == "full" or self.fill_mode == "horizontal" then
        self.rect.x = available_rect.x
        self.rect.w = available_rect.w
    end

    -- use all available height
    if self.fill_mode == "full" or self.fill_mode == "vertical" then
        self.rect.y = available_rect.y
        self.rect.h = available_rect.h
    end

    -- use minimum desired width
    if self.fill_mode == "none" or self.fill_mode == "horizontal" then
        local size_want_h = math.min(self.size_want.h, available_rect.h)
        if self.v_align == "top" then
            self.rect.y = available_rect.y
        elseif self.v_align == "bottom" then
            self.rect.y = available_rect.y + available_rect.h - size_want_h
        else
            self.rect.y = available_rect.y + math.floor((available_rect.h - size_want_h) / 2)
        end
        self.rect.h = size_want_h
    end

    -- use minimum desired height
    if self.fill_mode == "none" or self.fill_mode == "vertical" then
        local size_want_w = math.min(self.size_want.w, available_rect.w)
        if self.h_align == "left" then
            self.rect.x = available_rect.x
        elseif self.h_align == "right" then
            self.rect.x = available_rect.x + available_rect.w - size_want_w
        else
            self.rect.x = available_rect.x + math.floor((available_rect.w - size_want_w) / 2)
        end

        self.rect.w = size_want_w
    end
end

function Widget:draw(buf)
    if self.visible then
        GUI.render:blit_rect(self.rect.x, self.rect.y, self.rect.w, self.rect.h, self.bg_color, buf)
    end
end

function Widget:set_visible(visible)
    local is_visible = visible or GUI.root == self
    if self.visible ~= is_visible then
        self.visible = is_visible
        GUI.redraw = true
    end
end

function Widget:set_fill_mode(fill_mode)
    if self.fill_mode ~= fill_mode then
        self.fill_mode = fill_mode
        GUI.resize = true
    end
end

function Widget:set_h_align(h_align)
    if self.h_align ~= h_align then
        self.h_align = h_align
        GUI.resize = true
    end
end

function Widget:set_v_align(v_align)
    if self.v_align ~= v_align then
        self.v_align = v_align
        GUI.resize = true
    end
end

function Widget:set_fg_color(fg_color)
    if self.fg_color ~= fg_color then
        self.fg_color = fg_color
        if self.visible then
            GUI.redraw = true
        end
    end
end

function Widget:set_bg_color(bg_color)
    if self.bg_color ~= bg_color then
        self.bg_color = bg_color
        if self.visible then
            GUI.redraw = true
        end
    end
end

function Widget:is_focused()
    return GUI.focused == self
end

function Widget:set_focused()
    -- set this widget as focused
    -- if it is not visible, then set no widget as focused
    if self:is_focused() then
        return
    end

    if self.visible then
        if GUI.focused and GUI.focused.on_lose_focus then
            GUI.focused:on_lose_focus()
        end

        GUI.focused = self
        term.setCursorBlink(false)
        if self.on_focus then
            self:on_focus()
        end
    else
        GUI.focused = nil
    end
end

function Widget:get_widget_by_pos(x, y)
    -- get the widget at the given position

    if self.visible and x >= self.rect.x and x < self.rect.x + self.rect.w and y >= self.rect.y and y < self.rect.y + self.rect.h then
        return self
    end
end

function Widget:get_inner_rect()
    return {
        x = self.rect.x + self.padding.left,
        y = self.rect.y + self.padding.top,
        w = self.rect.w - self.padding.left - self.padding.right,
        h = self.rect.h - self.padding.top - self.padding.bottom
    }
end

function Widget:handle_click(btn, x, y)
    self:set_focused()
    if self.on_click then
        self:on_click(btn, x, y)
    end
end

function Widget:handle_tick()
    if self.on_tick then
        self:on_tick()
    end
end

function Widget:handle_event(event, ...)
    if self.event_handlers[event] then
        self.event_handlers[event](self, ...)
    end
end

Frame = Widget:new()
Frame.__index = Frame

function Frame:new(show_border)
    local o = Widget:new()
    setmetatable(o, self)
    o.super = Widget
    o.show_border = show_border or false
    o.border_chars = border_presets.default
    return o
end

function Frame:update_size_want()
    if self.child then
        self.child:update_size_want()
        self.size_want.w = self.child.size_want.w + self.padding.left + self.padding.right
        self.size_want.h = self.child.size_want.h + self.padding.top + self.padding.bottom
    else
        self.size_want.w = self.padding.left + self.padding.right
        self.size_want.h = self.padding.top + self.padding.bottom
    end
end

function Frame:update_rect(available_rect)
    self.super.update_rect(self, available_rect)

    if self.child then
        -- resize child to fit available space
        local child_rect = self:get_inner_rect()
        self.child:update_rect(child_rect)
    end
end

function Frame:draw(buf)
    self.super.draw(self, buf)

    if self.show_border and self.visible then
        if self.padding.top > 0 or self.padding.left > 0 then
            GUI.render:blit_char(self.border_chars.top_left[1], self.rect.x, self.rect.y, (self.border_chars.top_left[2] and self.bg_color) or self.fg_color, (self.border_chars.top_left[2] and self.fg_color) or self.bg_color, buf)
        end
        if self.padding.top > 0 or self.padding.right > 0 then
            GUI.render:blit_char(self.border_chars.top_right[1], self.rect.x + self.rect.w - 1, self.rect.y, (self.border_chars.top_right[2] and self.bg_color) or self.fg_color, (self.border_chars.top_right[2] and self.fg_color) or self.bg_color, buf)
        end
        if self.padding.bottom > 0 or self.padding.left > 0 then
            GUI.render:blit_char(self.border_chars.bottom_left[1], self.rect.x, self.rect.y + self.rect.h - 1, (self.border_chars.bottom_left[2] and self.bg_color) or self.fg_color, (self.border_chars.bottom_left[2] and self.fg_color) or self.bg_color, buf)
        end
        if self.padding.bottom > 0 or self.padding.right > 0 then
            GUI.render:blit_char(self.border_chars.bottom_right[1], self.rect.x + self.rect.w - 1, self.rect.y + self.rect.h - 1, (self.border_chars.bottom_right[2] and self.bg_color) or self.fg_color, (self.border_chars.bottom_right[2] and self.fg_color) or self.bg_color, buf)
        end

        if self.rect.w > 2 then
            for i = 1, self.rect.w - 2 do
                if self.padding.top > 0 then
                    GUI.render:blit_char(self.border_chars.top[1], self.rect.x + i, self.rect.y, (self.border_chars.top[2] and self.bg_color) or self.fg_color, (self.border_chars.top[2] and self.fg_color) or self.bg_color, buf)
                end
                if self.padding.bottom > 0 then
                    GUI.render:blit_char(self.border_chars.bottom[1], self.rect.x + i, self.rect.y + self.rect.h - 1, (self.border_chars.bottom[2] and self.bg_color) or self.fg_color, (self.border_chars.bottom[2] and self.fg_color) or self.bg_color, buf)
                end
            end
        end

        if self.rect.h > 2 then
            for i = 1, self.rect.h - 2 do
                if self.padding.left > 0 then
                    GUI.render:blit_char(self.border_chars.left[1], self.rect.x, self.rect.y + i, (self.border_chars.left[2] and self.bg_color) or self.fg_color, (self.border_chars.left[2] and self.fg_color) or self.bg_color, buf)
                end
                if self.padding.right > 0 then
                    GUI.render:blit_char(self.border_chars.right[1], self.rect.x + self.rect.w - 1, self.rect.y + i, (self.border_chars.right[2] and self.bg_color) or self.fg_color, (self.border_chars.right[2] and self.fg_color) or self.bg_color, buf)
                end
            end
        end
    end

    if self.child and self.visible then
        self.child:draw(buf)
    end
end

function Frame:get_widget_by_pos(x, y)
    if self.visible and x >= self.rect.x and x <= self.rect.x + self.rect.w and y >= self.rect.y and y <= self.rect.y + self.rect.h then
        if self.child then
            return self.child:get_widget_by_pos(x, y) or self
        else
            return self
        end
    end
end

function Frame:handle_tick()
    self.super.handle_tick(self)

    if self.child then
        self.child:handle_tick()
    end
end

function Frame:handle_event(event, ...)
    self.super.handle_event(self, event, ...)

    if self.child then
        self.child:handle_event(event, ...)
    end
end

function Frame:add_child(widget)
    -- add a child widget
    if not self.child then
        self.child = widget
        widget.parent = self
        if not widget.bg_color then
            widget.bg_color = self.bg_color
        end

        GUI.resize = true
        return true
    end
end

function Frame:get_child()
    return self.child
end

function Frame:remove_child()
    -- remove child widget
    if self.child then
        self.child.parent = nil
        self.child = nil
        GUI.resize = true
        return true
    end
end

Grid = Widget:new()
Grid.__index = Grid

function Grid:new(w, h)
    local o = Widget:new()
    setmetatable(o, self)
    o.super = Widget
    o.grid_size = {
        w = w,
        h = h,
    }
    o.weights = {
        rows = {},
        cols = {},
    }

    for x = 1, w do
        o.weights.cols[x] = 1
    end
    for y = 1, h do
        o.weights.rows[y] = 1
    end

    o.grid = {}
    return o
end

function Grid:update_size_want()
    -- recalculate wanted size for the widget
    self.size_want.row_lengths = {}
    self.size_want.col_lengths = {}
    self.size_want.row_widths = {}
    self.size_want.col_widths = {}
    for x = 1, self.grid_size.w do
        self.size_want.col_lengths[x] = 0
        self.size_want.col_widths[x] = 0
        for y = 1, self.grid_size.h do
            self.size_want.row_lengths[y] = self.size_want.row_lengths[y] or 0
            self.size_want.row_widths[y] = self.size_want.row_widths[y] or 0
            local key = x .. "." .. y
            if self.grid[key] then
                self.grid[key]:update_size_want()
                self.size_want.row_lengths[y] = self.size_want.row_lengths[y] + self.grid[key].size_want.w
                self.size_want.row_widths[y] = math.max(self.size_want.row_widths[y], self.grid[key].size_want.h)
                self.size_want.col_lengths[x] = self.size_want.col_lengths[x] + self.grid[key].size_want.h
                self.size_want.col_widths[x] = math.max(self.size_want.col_widths[x], self.grid[key].size_want.w)
            end
        end
    end

    self.size_want.w = self.padding.left + self.padding.right + math.max(unpack(self.size_want.row_lengths))
    self.size_want.h = self.padding.top + self.padding.bottom + math.max(unpack(self.size_want.col_lengths))
end

function Grid:update_rect(available_rect)
    self.super.update_rect(self, available_rect)

    local extra_space = {
        w = self.rect.w - self.size_want.w,
        h = self.rect.h - self.size_want.h,
    }
    
    -- normalize the weights, and calculate height of rows and width of columns
    local cell_sizes = {
        rows = {},
        cols = {},
    }

    for i, weight in ipairs(self.weights.rows) do
        local weight_norm = weight / util.sum(unpack(self.weights.rows))
        cell_sizes.rows[i] = self.size_want.row_widths[i] + util.round(extra_space.h * weight_norm)
    end

    for i, weight in ipairs(self.weights.cols) do
        local weight_norm = weight / util.sum(unpack(self.weights.cols))
        cell_sizes.cols[i] = self.size_want.col_widths[i] + util.round(extra_space.w * weight_norm)
    end

    -- assign children the appropriate rects for their row/col position
    for x = 1, self.grid_size.w do
        for y = 1, self.grid_size.h do
            local key = x .. "." .. y
            if self.grid[key] then
                local child_rect = {
                    x = self.rect.x + self.padding.left + util.sum(unpack(cell_sizes.cols, 1, x - 1)),
                    y = self.rect.y + self.padding.top + util.sum(unpack(cell_sizes.rows, 1, y - 1)),
                    w = cell_sizes.cols[x],
                    h = cell_sizes.rows[y],
                }

                self.grid[key]:update_rect(child_rect)
            end
        end
    end
end

function Grid:draw(buf)
    self.super.draw(self, buf)

    for x = 1, self.grid_size.w do
        for y = 1, self.grid_size.h do
            local key = x .. "." .. y
            if self.grid[key] then
                self.grid[key]:draw(buf)
            end
        end
    end
end

function Grid:get_widget_by_pos(x, y)
    if x >= self.rect.x and x <= self.rect.x + self.rect.w and y >= self.rect.y and y <= self.rect.y + self.rect.h then
        for h = 1, self.grid_size.w do
            for k = 1, self.grid_size.h do
                local key = h .. "." .. k
                if self.grid[key] then
                    widget = self.grid[key]:get_widget_by_pos(x, y)
                    if widget then
                        return widget
                    end
                end
            end
        end

        return self
    end
end

function Grid:handle_tick()
    self.super.handle_tick(self)

    for h = 1, self.grid_size.w do
        for k = 1, self.grid_size.h do
            local key = h .. "." .. k
            if self.grid[key] then
                self.grid[key]:handle_tick()
            end
        end
    end
end

function Grid:handle_event(event, ...)
    self.super.handle_event(self, event, ...)

    for h = 1, self.grid_size.w do
        for k = 1, self.grid_size.h do
            local key = h .. "." .. k
            if self.grid[key] then
                self.grid[key]:handle_event(event, ...)
            end
        end
    end
end

function Grid:add_child(widget, x, y)
    if x > 0 and x <= self.grid_size.w and y > 0 and y <= self.grid_size.h then
        local key = x .. "." .. y
        if not self.grid[key] then
            self.grid[key] = widget
            widget.parent = self
            if not widget.bg_color then
                widget.bg_color = self.bg_color
            end

            GUI.resize = true
            return true
        end
    end
end

function Grid:get_child(x, y)
    return self.grid[x .. "." .. y]
end

function Grid:remove_child(x, y)
    local key = x .. "." .. y
    if self.grid[key] then
        self.grid[key].parent = nil
        self.grid[key] = nil
        GUI.resize = true
        return true
    end
end

Text = Widget:new()
Text.__index = Text

function Text:new(text, text_align)
    local o = Widget:new()
    setmetatable(o, self)
    o.super = Widget
    o.text = ""
    o.text_align = text_align or "left"
    o.wrapping = true
    o.text_changed = false
    o.lines = {}
    o.max_len = 0
    o.wrapped_lines = {}
    o.wrapped_max_len = 0
    o:set_text(text or "")
    return o
end

function Text:update_size_want()
    -- recalculate wanted size for the widget
    self.size_want.w = self.max_len + self.padding.left + self.padding.right
    self.size_want.h = self.padding.top + self.padding.bottom + ((#self.wrapped_lines > 0 and #self.wrapped_lines) or ((#self.lines > 0 and #self.lines) or 1))
end

function Text:update_rect(available_rect)
    if self.rect.w ~= available_rect.w then
        self.text_changed = true
    end

    self.super.update_rect(self, available_rect)

    if self.text_changed then
        self.text_changed = false
        GUI.resize = true

        self.wrapped_lines = {}
        self.wrapped_max_len = 0
        if self.wrapping and self.max_len + self.padding.left + self.padding.right > available_rect.w then
            for i, line in ipairs(self.lines) do
                local wrapped_lines = util.wrap_text(line, available_rect.w - self.padding.left - self.padding.right)
                for j, wrapped_line in ipairs(wrapped_lines) do
                    self.wrapped_max_len = math.max(self.wrapped_max_len, wrapped_line:len())
                    table.insert(self.wrapped_lines, wrapped_line)
                end
            end
        end
    end
end

function Text:draw(buf)
    self.super.draw(self, buf)

    if self.visible then
        local text_buf = {}
        for i, line in ipairs((#self.wrapped_lines > 0 and self.wrapped_lines) or self.lines) do
            local x_offset
            local y_offset = self.padding.top + i - 1
            if self.text_align == "left" then
                x_offset = self.padding.left
            elseif self.text_align == "right" then
                x_offset = self.rect.w - line:len() - self.padding.right + 1
            else
                x_offset = self.padding.left + math.floor((self.rect.w - self.padding.left - self.padding.right - line:len()) / 2)
            end

            GUI.render:blit_text(line, self.rect.x + x_offset, self.rect.y + y_offset, self.fg_color, self.bg_color, text_buf)
        end

        local text_container_rect = self:get_inner_rect()
        GUI.render:blit_buf(text_buf, buf, text_container_rect.x, text_container_rect.y, text_container_rect.x + text_container_rect.w - 1, text_container_rect.y + text_container_rect.h - 1)
    end
end

function Text:set_text(text)
    if self.text ~= text then
        self.text = text
        self.lines = {}
        self.max_len = 0
        for line in self.text:gmatch("([^\n]*)\n?") do
            self.max_len = math.max(self.max_len, line:len())
            table.insert(self.lines, line)
        end
        self.text_changed = true
        GUI.resize = true
    end
end

Input = Widget:new()
Input.__index = Input

function Input:new(text, hint_text, box_width, hint_color, box_color)
    local o = Widget:new()
    setmetatable(o, self)
    o.super = Widget
    o.text = text or ""
    o.box_width = box_width or 10
    o.box_color = box_color or colors.gray
    o.hint_text = hint_text or ""
    o.hint_color = hint_color or colors.light_gray
    o.cursor_index = 1
    o.scroll = 1
    return o
end

function Input:update_size_want()
    -- recalculate wanted size for the widget
    self.size_want.w = self.box_width + self.padding.left + self.padding.right
    self.size_want.h = self.padding.top + self.padding.bottom + 1
end

function Input:update_rect(available_rect)
    self.super.update_rect(self, available_rect)

    if self:is_focused() then
        self:set_cursor_index()
    end
end

function Input:draw(buf)
    self.super.draw(self, buf)

    local actual_box_width = self.rect.w - self.padding.left - self.padding.right
    local y_offset = self.padding.top + math.floor((self.rect.h - self.padding.top - self.padding.bottom - 1) / 2)

    local shown_text = self.text:len() > 0 and self.text:sub(self.scroll) or self.hint_text
    local text_color = self.text:len() > 0 and self.fg_color or self.hint_color
    GUI.render:blit_rect(self.rect.x + self.padding.left, self.rect.y + y_offset, actual_box_width, 1, self.box_color, buf)
    GUI.render:blit_text(shown_text:sub(1, actual_box_width), self.rect.x + self.padding.left, self.rect.y + y_offset, text_color, self.box_color, buf)
end

function Input:set_focused()
    self.super.set_focused(self)

    term.setCursorBlink(true)
    self:set_cursor_index()
end

function Input:handle_click(btn, x, y)
    self.super.handle_click(self, btn, x, y)

    local local_x = x - self.rect.x
    local local_y = y - self.rect.y
    if local_x >= self.padding.left and local_x <= self.rect.w - self.padding.right and local_y == self.padding.top + math.floor((self.rect.h - self.padding.top - self.padding.bottom - 1) / 2) then
        local clicked_cursor_index = local_x - self.padding.left + self.scroll
        self:set_cursor_index(clicked_cursor_index)
    end
end

function Input:handle_event(event, ...)
    self.super.handle_event(self, event, ...)

    if self:is_focused() then
        if event == "key" then
            local key = ...
            if key == keys.backspace then
                local oldText = self.text
                self.text = self.text:sub(1, math.max(0, self.cursor_index - 2)) .. self.text:sub(self.cursor_index)
                self:set_cursor_index(self.cursor_index - 1)
                GUI.redraw = true
                if self.text ~= oldText and self.on_change then
                    self:on_change(oldText)
                end
            elseif key == keys.delete then
                local oldText = self.text
                self.text = self.text:sub(1, self.cursor_index - 1) .. self.text:sub(self.cursor_index + 1)
                GUI.redraw = true
                if self.text ~= oldText and self.on_change then
                    self:on_change(oldText)
                end
            elseif key == keys.home then
                self:set_cursor_index(1)
            elseif key == keys["end"] then
                self:set_cursor_index(self.text:len() + 1)
            elseif key == keys.left then
                self:set_cursor_index(self.cursor_index - 1)
            elseif key == keys.right then
                self:set_cursor_index(self.cursor_index + 1)
            elseif key == keys.enter and self.on_enter then
                self:on_enter()
            end
        end

        if event == "char" then
            local char = ...
            local oldText = self.text
            self.text = self.text:sub(1, self.cursor_index - 1) .. char .. self.text:sub(self.cursor_index)
            self:set_cursor_index(self.cursor_index + 1)
            GUI.redraw = true
            if self.on_change then
                self:on_change(oldText)
            end
        end
    end
end

function Input:set_cursor_index(index)
    if index then
        self.cursor_index = index
    end

    self.cursor_index = math.max(1, math.min(self.cursor_index, self.text:len() + 1))
    local actual_box_width = self.rect.w - self.padding.left - self.padding.right
    local box_cursor_x = self.cursor_index - self.scroll + 1
    if box_cursor_x > actual_box_width then
        self.scroll = self.scroll + 1
        GUI.redraw = true
    end

    if box_cursor_x <= 1 and self.scroll > 1 then
        self.scroll = self.scroll - 1
        GUI.redraw = true
    end

    local y_offset = self.padding.top + math.floor((self.rect.h - self.padding.top - self.padding.bottom - 1) / 2)
    term.setCursorPos(self.rect.x + self.padding.left + self.cursor_index - self.scroll, self.rect.y + y_offset)
end

function Input:set_text(text)
    if self.text ~= text then
        self.text = text
        self:set_cursor_index()
        GUI.redraw = true
    end
end

function Input:set_hint_text(text)
    if self.hint_text ~= text then
        self.hint_text = text
        GUI.redraw = true
    end
end

function Input:set_box_width(width)
    if self.box_width ~= width then
        self.box_width = width
        GUI.resize = true
        self:set_cursor_index()
    end
end

function Input:set_hint_color(color)
    if self.hint_color ~= color then
        self.hint_color = color
        GUI.redraw = true
    end
end

function Input:set_box_color(color)
    if self.box_color ~= color then
        self.box_color = color
        GUI.redraw = true
    end
end

Scrollable = Widget:new()
Scrollable.__index = Scrollable

scrollbar_chars = {
    vertical = {
        default = {
            full = {"\149", true},
            top1 = {"\159", true},
            top2 = {"\151", true},
            bottom1 = {"\130", false},
            bottom2 = {"\138", false},
        },
        flipped = {
            full = {"\149", false},
            top1 = {"\144", false},
            top2 = {"\148", false},
            bottom1 = {"\129", false},
            bottom2 = {"\133", false},
        },
    },
    horizontal = {
        default = {
            full = {"\143", true},
            left = {"\159", true},
            right = {"\144", false},
        },
        flipped = {
            full = {"\131", false},
            left = {"\130", false},
            right = {"\129", false},
        },
    },
}

function Scrollable:new(min_size, scroll_dir, show_scrollbar, flip_scrollbar_side)
    local o = Widget:new()
    setmetatable(o, self)
    o.super = Widget
    o.scroll = 1
    o.scroll_max = 1
    o.min_size = min_size or 10
    o.scroll_dir = scroll_dir or "vertical"
    o.show_scrollbar = show_scrollbar or true
    o.flip_scrollbar_side = flip_scrollbar_side or false
    return o
end

function Scrollable:update_size_want()
    if self.child then
        self.child:update_size_want()
        self.size_want.w = self.child.size_want.w + self.padding.left + self.padding.right
        self.size_want.h = self.child.size_want.h + self.padding.top + self.padding.bottom
    else
        self.size_want.w = self.padding.left + self.padding.right
        self.size_want.h = self.padding.top + self.padding.bottom
    end

    if self.scroll_dir == "vertical" then
        if self.show_scrollbar then
            self.size_want.w = self.size_want.w + 1
        end
        self.size_want.h = self.min_size
    elseif self.scroll_dir == "horizontal" then
        if self.show_scrollbar then
            self.size_want.h = self.size_want.h + 1
        end
        self.size_want.w = self.min_size
    end
end

function Scrollable:update_rect(available_rect)
    self.super.update_rect(self, available_rect)

    if self.child then
        -- resize child to fit available space
        local child_rect_space = self:get_inner_rect()

        local child_rect = {}
        if self.scroll_dir == "vertical" then
            child_rect.x = child_rect_space.x + (self.show_scrollbar and self.flip_scrollbar_side and 1 or 0)
            child_rect.y = child_rect_space.y - self.scroll + 1
            child_rect.w = child_rect_space.w - (self.show_scrollbar and 1 or 0)
            child_rect.h = math.max(self.child.size_want.h, child_rect_space.h)
            self.scroll_max = math.max(1, child_rect.h - child_rect_space.h + 1)
        elseif self.scroll_dir == "horizontal" then
            child_rect.x = child_rect_space.x - self.scroll + 1
            child_rect.y = child_rect_space.y + (self.show_scrollbar and self.flip_scrollbar_side and 1 or 0)
            child_rect.w = math.max(self.child.size_want.w, child_rect_space.w)
            child_rect.h = child_rect_space.h - (self.show_scrollbar and 1 or 0)
            self.scroll_max = math.max(1, child_rect.w - child_rect_space.w + 1)
        else
            child_rect = child_rect_space
        end

        self.scroll = math.max(1, math.min(self.scroll_max, self.scroll))
        self.child:update_rect(child_rect)
    end
end

function Scrollable:draw(buf)
    self.super.draw(self, buf)

    if self.child and self.visible then
        local child_visible_rect = self:get_inner_rect()

        if self.show_scrollbar then
            if self.scroll_dir == "vertical" then
                child_visible_rect.w = child_visible_rect.w - 1
                if self.flip_scrollbar_side then
                    child_visible_rect.x = child_visible_rect.x + 1
                end
            elseif self.scroll_dir == "horizontal" then
                child_visible_rect.h = child_visible_rect.h - 1
                if self.flip_scrollbar_side then
                    child_visible_rect.y = child_visible_rect.y + 1
                end
            end
        end

        local child_buf = {}
        self.child:draw(child_buf)
        GUI.render:blit_buf(child_buf, buf, child_visible_rect.x, child_visible_rect.y, child_visible_rect.x + child_visible_rect.w - 1, child_visible_rect.y + child_visible_rect.h - 1)

        if self.show_scrollbar and self.scroll_max > 1 then
            if self.scroll_dir == "vertical" then
                local scrollbar_space = child_visible_rect.h * 3
                local scrollbar_height = scrollbar_space - self.scroll_max + 1
                local scrollbar_offset = 0
                if scrollbar_height < 3 then
                    scrollbar_height = 3
                    scrollbar_offset = math.floor((self.scroll / self.scroll_max) * (scrollbar_space - 3))
                else
                    scrollbar_offset = self.scroll - 1
                end

                scrollbar_charset = scrollbar_chars[self.scroll_dir][self.flip_scrollbar_side and "flipped" or "default"]
                local x = child_visible_rect.x + (not self.flip_scrollbar_side and child_visible_rect.w or -1)
                for y = child_visible_rect.y, child_visible_rect.y + child_visible_rect.h - 1 do
                    local render_char = nil
                    if scrollbar_offset >= 3 then
                        scrollbar_offset = scrollbar_offset - 3
                    elseif scrollbar_offset == 2 then
                        render_char = scrollbar_charset.top1
                        scrollbar_offset = 0
                        scrollbar_height = scrollbar_height - 1
                    elseif scrollbar_offset == 1 then
                        render_char = scrollbar_charset.top2
                        scrollbar_offset = 0
                        scrollbar_height = scrollbar_height - 2
                    else
                        if scrollbar_height >= 3 then
                            render_char = scrollbar_charset.full
                            scrollbar_height = scrollbar_height - 3
                        elseif scrollbar_height == 2 then
                            render_char = scrollbar_charset.bottom2
                            scrollbar_height = 0
                        elseif scrollbar_height == 1 then
                            render_char = scrollbar_charset.bottom1
                            scrollbar_height = 0
                        end
                    end

                    if render_char then
                        GUI.render:blit_char(render_char[1], x, y, render_char[2] and self.bg_color or self.fg_color, render_char[2] and self.fg_color or self.bg_color, buf)
                    end
                end
            elseif self.scroll_dir == "horizontal" then
                local scrollbar_space = child_visible_rect.w * 2
                local scrollbar_width = scrollbar_space - self.scroll_max + 1
                local scrollbar_offset = 0
                if scrollbar_width < 2 then
                    scrollbar_width = 2
                    scrollbar_offset = math.floor((self.scroll / self.scroll_max) * (scrollbar_space - 2))
                else
                    scrollbar_offset = self.scroll - 1
                end

                scrollbar_charset = scrollbar_chars[self.scroll_dir][self.flip_scrollbar_side and "flipped" or "default"]
                local y = child_visible_rect.y + (not self.flip_scrollbar_side and child_visible_rect.h or -1)
                for x = child_visible_rect.x, child_visible_rect.x + child_visible_rect.w - 1 do
                    local render_char = nil
                    if scrollbar_offset >= 2 then
                        scrollbar_offset = scrollbar_offset - 2
                    elseif scrollbar_offset == 1 then
                        render_char = scrollbar_charset.left
                        scrollbar_offset = 0
                        scrollbar_width = scrollbar_width - 1
                    else
                        if scrollbar_width >= 2 then
                            render_char = scrollbar_charset.full
                            scrollbar_width = scrollbar_width - 2
                        elseif scrollbar_width == 1 then
                            render_char = scrollbar_charset.right
                            scrollbar_width = 0
                        end
                    end

                    if render_char then
                        GUI.render:blit_char(render_char[1], x, y, render_char[2] and self.bg_color or self.fg_color, render_char[2] and self.fg_color or self.bg_color, buf)
                    end
                end
            end
        end
    end
end

function Scrollable:set_scroll(scroll)
    local prev_scroll = self.scroll
    self.scroll = math.max(1, math.min(self.scroll_max, scroll))
    if self.scroll ~= prev_scroll then
        GUI.resize = true
        return true
    end
end

function Scrollable:handle_event(event, ...)
    self.super.handle_event(self, event, ...)

    if event == "mouse_scroll" then
        local dir, x, y = ...
        if self:get_widget_by_pos(x, y) == self then
            local scrolled = self:set_scroll(self.scroll + dir)
            if not scrolled and self.child then
                self.child:handle_event(event, ...)
            end
        end
    else
        if self.child then
            self.child:handle_event(event, ...)
        end
    end
end

function Scrollable:get_widget_by_pos(x, y)
    if self.visible and x >= self.rect.x and x <= self.rect.x + self.rect.w and y >= self.rect.y and y <= self.rect.y + self.rect.h then
        if self.child then
            return self.child:get_widget_by_pos(x, y) or self
        else
            return self
        end
    end
end

function Scrollable:handle_tick()
    self.super.handle_tick(self)

    if self.child then
        self.child:handle_tick()
    end
end

function Scrollable:add_child(widget)
    -- add a child widget
    if not self.child then
        self.child = widget
        widget.parent = self
        if not widget.bg_color then
            widget.bg_color = self.bg_color
        end

        GUI.resize = true
        return true
    end
end

function Scrollable:get_child()
    return self.child
end

function Scrollable:remove_child()
    -- remove child widget
    if self.child then
        self.child.parent = nil
        self.child = nil
        GUI.resize = true
        return true
    end
end
